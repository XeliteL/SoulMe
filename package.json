{
  "name": "SoulMe",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "analyze": "next analyze",
    "format": "prettier --write \"./{app,src}/**/*.{ts,tsx,scss,json}\" \"./*.{ts,js}\" ./tsconfig.json \".github/**/*.yml\"",
    "format:check": "prettier --check \"./{app,src}/**/*.{ts,tsx,scss,json}\" \"./*.{ts,js}\" ./tsconfig.json \".github/**/*.yml\"",
    "lint": "eslint ./app ./src",
    "lint:fix": "eslint ./app ./src --fix",
    "stylelint": "stylelint \"./{app,src}/**/*.scss\" --allow-empty-input",
    "stylelint:fix": "stylelint \"./{app,src}/**/*.scss\" --allow-empty-input --fix",
    "check": "npm run format:check && npm run lint && npm run stylelint && npm run test",
    "typecheck": "next typegen && tsc --noEmit",
    "fix": "npm run format && npm run lint:fix && npm run stylelint:fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "svgo": "svgo --multipass -r -f ./public && svgo --multipass -r -f ./src/shared/assets"
  },
  "prettier": {
    "semi": false
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jsdom": "^30.1.3",
    "postcss-pxtorem": "^6.1.0",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "stylelint": "^17.14.0",
    "svgo": "^4.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.0.11",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@a1rth/css-normalize": "~1.1.9",
    "classnames": "^2.5.1",
    "imask": "^7.6.1",
    "next": "^16.4.3",
    "postcss-preset-env": "^11.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swiper": "14.4.0",
    "zod": "^4.6.7"
  }
}
