{
  "name": "SoulMe",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "analyze": "next analyze",
    "format": "prettier --write \"./{app,src}/**/*.{ts,tsx,scss,json}\" \"./*.{ts,js}\" ./tsconfig.json \".github/**/*.yml\"",
    "format:check": "prettier --check \"./{app,src}/**/*.{ts,tsx,scss,json}\" \"./*.{ts,js}\" ./tsconfig.json \".github/**/*.yml\"",
    "lint": "eslint ./app ./src",
    "lint:fix": "eslint ./app ./src --fix",
    "stylelint": "stylelint \"./{app,src}/**/*.scss\" --allow-empty-input",
    "stylelint:fix": "stylelint \"./{app,src}/**/*.scss\" --allow-empty-input --fix",
    "check": "npm run format:check && npm run lint && npm run stylelint && npm run test",
    "fix": "npm run format && npm run lint:fix && npm run stylelint:fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prettier": {
    "semi": false
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jsdom": "^30.0.1",
    "postcss-pxtorem": "^6.1.0",
    "prettier": "^3.9.4",
    "sass": "^1.101.0",
    "stylelint": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.0.11",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@a1rth/css-normalize": "^1.1.9",
    "classnames": "^2.5.1",
    "imask": "^7.6.1",
    "next": "^16.4.0",
    "postcss-preset-env": "^11.3.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "swiper": "12.1.2"
  }
}
